[discord]
token = YOUR_BOT_TOKEN_HERE
guild_id =

[admin]
# Comma-separated Discord user IDs who can control VPSes
admins = 123456789012345678
# Optional: a Discord role ID that grants admin privileges (takes precedence)
admin_role_id =

[docker]
# Default Docker image pull timeout seconds
pull_timeout = 300

[limits]
# Default RAM limit in MB for deployed containers
default_mem_mb = 512
# Default CPU cores (can be fractional)
default_cpu = 0.5

[app]
db_path = data.db
logs_dir = ../logs
# Optional logging controls
log_json = False
log_level = INFO

# Optional Sentry DSN for error tracking
sentry_dsn =

[expiry]
# Default expiry for new VPS deployments when no expiry is provided
default_days = 7
default_hours = 0
# Cleanup expired VPS records and containers every N seconds. Set to 0 to disable.
cleanup_interval_seconds = 600
